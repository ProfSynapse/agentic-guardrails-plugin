{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Write|Edit|NotebookEdit|Read|apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/claude/_dispatch.py\" pretooluse || python \"${CLAUDE_PLUGIN_ROOT}/scripts/claude/_dispatch.py\" pretooluse",
            "timeout": 15,
            "statusMessage": "guardrails check",
            "commandWindows": "py.exe -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\claude\\_dispatch.py\" pretooluse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Write|Edit|NotebookEdit|Read|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/claude/_dispatch.py\" posttooluse || python \"${CLAUDE_PLUGIN_ROOT}/scripts/claude/_dispatch.py\" posttooluse",
            "timeout": 10,
            "commandWindows": "py.exe -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\claude\\_dispatch.py\" posttooluse"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/claude/_dispatch.py\" sessionstart || python \"${CLAUDE_PLUGIN_ROOT}/scripts/claude/_dispatch.py\" sessionstart",
            "timeout": 15,
            "commandWindows": "py.exe -3 \"${CLAUDE_PLUGIN_ROOT}\\scripts\\claude\\_dispatch.py\" sessionstart"
          }
        ]
      }
    ]
  }
}
