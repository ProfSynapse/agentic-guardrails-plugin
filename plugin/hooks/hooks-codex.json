{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Write|Edit|NotebookEdit|Read|apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/codex/_dispatch.py\" pretooluse || python \"${PLUGIN_ROOT}/scripts/codex/_dispatch.py\" pretooluse",
            "commandWindows": "py.exe -3 \"${PLUGIN_ROOT}\\scripts\\codex\\_dispatch.py\" pretooluse",
            "timeout": 120,
            "statusMessage": "guardrails check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor|Write|Edit|NotebookEdit|Read|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/codex/_dispatch.py\" posttooluse || python \"${PLUGIN_ROOT}/scripts/codex/_dispatch.py\" posttooluse",
            "commandWindows": "py.exe -3 \"${PLUGIN_ROOT}\\scripts\\codex\\_dispatch.py\" posttooluse",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/codex/_dispatch.py\" sessionstart || python \"${PLUGIN_ROOT}/scripts/codex/_dispatch.py\" sessionstart",
            "commandWindows": "py.exe -3 \"${PLUGIN_ROOT}\\scripts\\codex\\_dispatch.py\" sessionstart",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
